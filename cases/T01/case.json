{
  "id": "T01",
  "title": "订单与退款的跨表去重统计",
  "description": "读取两张含完全重复行和版本更新的CSV；先按业务ID与revision去完全重复，再按业务ID保留最大revision。仅paid/shipped订单入选；仅最新版status=success、关联入选订单的退款影响净额。交付全量逐单台账、总体/客户组汇总、异常计数与ID列表。所有金额整数分，主键唯一，JSON数组按prompt指定顺序。",
  "prompt_file": "prompt.md",
  "input_dir": "inputs",
  "required_outputs": [
    "order_ledger.csv",
    "aggregate.json",
    "exceptions.json"
  ],
  "oracle_file": "oracle.json",
  "checks": [
    {
      "id": "T01-C01",
      "title": "全订单逐单台账及排除状态",
      "kind": "csv_rows",
      "weight": 30,
      "config": {
        "path": "order_ledger.csv",
        "key_columns": [
          "order_id"
        ],
        "oracle_key": "ledger"
      }
    },
    {
      "id": "T01-C02",
      "title": "总体入选订单与金额统计",
      "kind": "json_fields",
      "weight": 20,
      "config": {
        "path": "aggregate.json",
        "oracle_key": "aggregate_total"
      }
    },
    {
      "id": "T01-C03",
      "title": "按客户组统计",
      "kind": "json_fields",
      "weight": 15,
      "config": {
        "path": "aggregate.json",
        "oracle_key": "aggregate_groups"
      }
    },
    {
      "id": "T01-C04",
      "title": "订单完全重复行识别",
      "kind": "json_fields",
      "weight": 5,
      "config": {
        "path": "exceptions.json",
        "oracle_key": "order_duplicates"
      }
    },
    {
      "id": "T01-C05",
      "title": "订单过时版本识别",
      "kind": "json_fields",
      "weight": 5,
      "config": {
        "path": "exceptions.json",
        "oracle_key": "order_superseded"
      }
    },
    {
      "id": "T01-C06",
      "title": "退款去重与最新版识别",
      "kind": "json_fields",
      "weight": 5,
      "config": {
        "path": "exceptions.json",
        "oracle_key": "refund_deduplication"
      }
    },
    {
      "id": "T01-C07",
      "title": "无效状态及不合格订单退款排除",
      "kind": "json_fields",
      "weight": 10,
      "config": {
        "path": "exceptions.json",
        "oracle_key": "ignored_refunds"
      }
    },
    {
      "id": "T01-C08",
      "title": "孤儿退款识别",
      "kind": "json_fields",
      "weight": 10,
      "config": {
        "path": "exceptions.json",
        "oracle_key": "orphan_refunds"
      }
    }
  ]
}
